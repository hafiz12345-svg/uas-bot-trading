# Salin file ini jadi .env (lokal) atau isi di Environment Variables Vercel.
# JANGAN pernah mengisi nilai asli di file ini dan jangan commit .env.

# Upstash Redis (REST API), dari dashboard Upstash / integrasi Vercel
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Kunci rahasia untuk memanggil /api/tick.
# Isi sama dengan GitHub Secret bernama CRON_SECRET.
CRON_SECRET=

# Kill switch: isi 1 untuk menghentikan bot tanpa deploy ulang
KILL_SWITCH=0
